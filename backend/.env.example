# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://niit:niit@localhost:5432/niit_seo

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (HTTPS).
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Next.js forwards X-Forwarded-For unchanged, so it cannot be trusted on its own. Set true
# only in production behind a reverse proxy (e.g. nginx) that appends the real client
# address; the right-most entry is then used. See docs/SECURITY.md. Keep the API bound to
# 127.0.0.1 or a private network so clients cannot bypass the proxies.
TRUST_PROXY_HEADERS=false

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

CRAWLER_USER_AGENT=NIIT-SEO-Agent/0.1 (+https://niit.edu.pk)
# Private ranges the crawler may reach (comma-separated CIDRs). Leave empty unless you
# crawl a server you own on a private network. Loopback and link-local are refused in
# production.
CRAWLER_ALLOWED_PRIVATE_NETWORKS=
CRAWLER_MAX_RESPONSE_BYTES=5000000
CRAWLER_MAX_REDIRECTS=10
CRAWLER_MAX_SITEMAPS=20
CRAWLER_MAX_DURATION_SECONDS=3600
WORKER_POLL_SECONDS=2.0
WORKER_STALE_AFTER_SECONDS=300

# none | ollama. The platform works fully with none. With ollama, each organisation
# must also turn AI on in its settings.
AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
# Used when an organisation does not name a model, e.g. llama3.1:8b. Empty = none.
OLLAMA_DEFAULT_MODEL=
# Longest wait for one model reply. On a PC without a GPU, 600 is more realistic.
AI_TIMEOUT_SECONDS=180
# Prompt window per request, in tokens. Larger needs more memory.
AI_CONTEXT_TOKENS=8192
# How long Ollama keeps the model loaded after a task (a duration with a unit, e.g. 30m or
# 2h; -1m keeps it until Ollama stops). Avoids waiting for the model to load each time.
AI_KEEP_ALIVE=30m

# Chromium for PDF reports. Empty uses `uv run playwright install chromium`.
REPORT_PDF_BROWSER_PATH=
# Scheduled crawls run only when this is true AND the project's schedule is on.
SCHEDULER_ENABLED=false
AI_MAX_ACTIVE_JOBS_PER_ORG=3
# Fernet keys (comma-separated) that encrypt integration credentials. The first key
# encrypts; all keys decrypt. Empty = credentials cannot be stored. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put a new key first, run `uv run python -m app.cli rotate-secrets`, then
# remove the old key. Back this value up separately from the database.
INTEGRATIONS_ENCRYPTION_KEYS=

# The dashboard's public address, used in links sent by email.
PUBLIC_BASE_URL=http://localhost:3000
# Outgoing email through your organisation's own mail server (no third-party service).
# Empty SMTP_HOST = email off: invitations give the administrator a link to share, and
# password resets go through an administrator (`app.cli reset-password`).
# Port 465 uses implicit TLS; other ports use STARTTLS when SMTP_STARTTLS=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Days of Google Search Console data each import fetches (7 to 480). Search Console is
# connected per organisation in the dashboard; see docs/SEARCH_CONSOLE.md.
SEARCH_CONSOLE_DAYS=90
