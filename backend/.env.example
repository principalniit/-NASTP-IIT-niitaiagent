# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://niit:niit@localhost:5432/niit_seo

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (HTTPS).
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

CRAWLER_USER_AGENT=NIIT-SEO-Agent/0.1 (+https://niit.edu.pk)

# none | ollama. The platform works fully with none.
AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
