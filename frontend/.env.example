# Copy to .env.local (never committed) and adjust. Both are read when the dashboard is
# built or started with `pnpm dev`; rebuild after changing them.

# The product's name on every screen, for example "NIIT AI SEO Agent".
NEXT_PUBLIC_PRODUCT_NAME=AI SEO Agent

# Where the dashboard forwards /api/v1 requests.
API_ORIGIN=http://127.0.0.1:8000
